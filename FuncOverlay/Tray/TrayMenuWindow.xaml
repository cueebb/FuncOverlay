<Window x:Class="FuncOverlay.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuncOverlay Tray"
        Width="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        FontFamily="Segoe UI, Arial">

    <Window.Resources>
        <Style x:Key="TrayMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE4E4E7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#FF18181B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#FF27272A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Floating Monochrome Tray Popup Matching Google AI Studio Preview -->
    <Grid Margin="8">
        <Border Width="264"
                Background="#F509090B"
                BorderBrush="#FF27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.75" />
            </Border.Effect>

            <StackPanel>
                <!-- Header matching WindowsTrayArea.tsx -->
                <Grid Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Monochrome Layered App Icon -->
                    <Canvas Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Rectangle Canvas.Left="5" Canvas.Top="1" Width="13" Height="13" RadiusX="3" RadiusY="3"
                                   Stroke="#FF52525B" StrokeThickness="1.2" Fill="#FF18181B" />
                        <Rectangle Canvas.Left="2" Canvas.Top="6" Width="13" Height="13" RadiusX="3" RadiusY="3"
                                   Stroke="#FFFFFFFF" StrokeThickness="1.4" Fill="#FFFFFFFF" />
                        <Rectangle Canvas.Left="5" Canvas.Top="9" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                   Fill="#FF09090B" />
                    </Canvas>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="FuncOverlay" FontSize="12" FontWeight="Bold" Foreground="#FFFFFFFF" />
                        <TextBlock Text="Background service active" FontSize="10" FontFamily="Consolas" Foreground="#FFA1A1AA" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#FF000000"
                            BorderBrush="#FF27272A"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="OverlayStatusText"
                                   Text="Active"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="#FFD4D4D8" />
                    </Border>
                </Grid>

                <Border Height="1" Background="#FF27272A" Margin="4,0,4,6" />

                <!-- Menu Item 1: Toggle Overlay -->
                <Button Style="{StaticResource TrayMenuItemStyle}" Click="ToggleOverlay_Click" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M2,5 H22 V19 H2 Z M6,10 H8 M10,10 H12 M14,10 H16 M18,10 H18 M7,14 H17"
                              Stroke="#FFA1A1AA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Toggle Overlay" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#FF000000" BorderBrush="#FF27272A" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="HotkeyBadgeText" Text="Alt + Space" FontSize="10" FontFamily="Consolas" Foreground="#FFD4D4D8" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Menu Item 2: Settings -->
                <Button Style="{StaticResource TrayMenuItemStyle}" Click="OpenSettings_Click" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M4,7 H20 M4,12 H20 M4,17 H20 M8,5 V9 M16,10 V14 M11,15 V19"
                              Stroke="#FFA1A1AA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Menu Item 3: Open 'plugins' Folder -->
                <Button Style="{StaticResource TrayMenuItemStyle}" Click="OpenPluginsFolder_Click" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M3,6 H9 L11,8 H21 V18 H3 Z"
                              Stroke="#FFA1A1AA" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Open 'plugins' Folder" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="./plugins" FontSize="10" FontFamily="Consolas" Foreground="#FF71717A" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border Height="1" Background="#FF27272A" Margin="4,4,4,6" />

                <!-- Menu Item 4: Restart Application -->
                <Button Style="{StaticResource TrayMenuItemStyle}" Click="RestartApp_Click" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M20,12 A8,8 0 1,1 17.6,6.3 L20,8.5 M20,4 V8.5 H15.5"
                              Stroke="#FFA1A1AA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Restart Application" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Menu Item 5: Exit FuncOverlay -->
                <Button Style="{StaticResource TrayMenuItemStyle}" Click="ExitApp_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M12,3 V11 M17.5,6.5 A7.5,7.5 0 1,1 6.5,6.5"
                              Stroke="#FFA1A1AA" StrokeThickness="1.5" StrokeStartLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Exit FuncOverlay" Foreground="#FFD4D4D8" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
