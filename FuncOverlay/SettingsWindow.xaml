<Window x:Class="FuncOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuncOverlay Settings"
        Width="696" Height="668"
        MinWidth="580" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI, Arial">

    <Window.Resources>
        <!-- Primary Button Style: Pure White Background, Black Text -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE4E4E7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD4D4D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style: Black Background, 1px White Outline, White Text -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF000000" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF18181B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF27272A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Window Control Button (_ and X) -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFA1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBg" Property="Background" Value="#FF18181B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBg" Property="Background" Value="#FF27272A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Monochrome Pill Toggle Switch (CheckBox) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40" Height="22"
                                CornerRadius="11"
                                Background="#FF18181B"
                                BorderBrush="#FF3F3F46"
                                BorderThickness="1"
                                Padding="2">
                            <Border x:Name="Knob"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="#FFA1A1AA"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="Knob" Property="Background" Value="#FF000000" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFE4E4E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Monochrome Slider -->
        <Style x:Key="MonochromeSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbCircle"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="#FFFFFFFF"
                                BorderBrush="#FF09090B"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Background" Value="#FFE4E4E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonochromeSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="4" CornerRadius="2" Background="#FF27272A" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#FFFFFFFF" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MonochromeSliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Monochrome TextBox (No default Windows blue focus ring) -->
        <Style x:Key="MonochromeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF09090B" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFFFFFF" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Monochrome ComboBox (Zero default Windows light/blue dropdown) -->
        <Style x:Key="MonochromeComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE4E4E7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#FF27272A" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#FF18181B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonochromeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF09090B" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MonochromeComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="CbBorder" Background="#FF09090B" BorderBrush="#FF27272A"
                                                BorderThickness="1" CornerRadius="6" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#FFA1A1AA" StrokeThickness="1.4"
                                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CbBorder" Property="BorderBrush" Value="#FF52525B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="9,5,24,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="180"
                                        Margin="0,4,0,0"
                                        Background="#FF09090B"
                                        BorderBrush="#FF27272A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Monochrome Minimal ScrollBar (Supports both Vertical and Horizontal) -->
        <Style x:Key="CustomScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#FF3F3F46"
                                CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF71717A" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA1A1AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Foreground" Value="#FF3F3F46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CustomScrollThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Height="6">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource CustomScrollThumbStyle}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Custom Frameless Window Container (Zero Default Windows Shell Chrome) -->
    <Grid Margin="8">
        <Border Background="#F509090B"
                BorderBrush="#FF27272A"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <!-- Main Settings Layout -->
                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Entire Top Header Is Draggable + Upper-Right ONLY Minimize (_) and Close (X) -->
                    <Border Grid.Row="0"
                            Background="Transparent"
                            BorderBrush="#FF27272A"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,16"
                            Margin="0,0,0,20"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                <TextBlock Text="Configure global overlay appearance, trigger hotkey, and manage plugins"
                                           FontSize="12" Foreground="#FFA1A1AA" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Upper-Right Window Controls: ONLY Minimize (_) and Close (X) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Button Style="{StaticResource WindowControlButtonStyle}"
                                        Click="MinimizeButton_Click"
                                        ToolTip="Minimize"
                                        Margin="0,0,4,0">
                                    <Path Data="M4,12 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource WindowControlButtonStyle}"
                                        Click="CloseButton_Click"
                                        ToolTip="Close">
                                    <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings Body with Custom ScrollBar -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,14,4">

                            <!-- =============================================================== -->
                            <!-- 1. GENERAL SECTION                                              -->
                            <!-- =============================================================== -->
                            <Border Background="#CC18181B" BorderBrush="#FF27272A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFE4E4E7" Margin="0,0,0,16" />

                                    <!-- First Setting: Run on startup (Boolean) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Run on startup" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFFFF" />
                                            <TextBlock Text="Automatically launch FuncOverlay in the background when Windows starts."
                                                       FontSize="11" Foreground="#FFA1A1AA" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="RunOnStartupCheckBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  Click="RunOnStartupCheckBox_Click" />
                                    </Grid>

                                    <Border Height="1" Background="#FF27272A" Margin="0,0,0,16" />

                                    <!-- Transition (ms) -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Transition (ms)" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFFFF" />
                                        <TextBlock x:Name="TransitionValueText" Text="250 ms" FontWeight="Bold" FontSize="12" FontFamily="Consolas"
                                                   Foreground="#FFE4E4E7" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="TransitionSlider"
                                            Style="{StaticResource MonochromeSliderStyle}"
                                            Minimum="50" Maximum="1000" SmallChange="25" LargeChange="50" Value="250"
                                            ValueChanged="TransitionSlider_ValueChanged"
                                            PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"
                                            Margin="0,4,0,2" />
                                    <TextBlock Text="Duration of the screen tint animation in milliseconds (Default: 250ms)."
                                               FontSize="11" Foreground="#FFA1A1AA" Margin="0,0,0,16" />

                                    <Border Height="1" Background="#FF27272A" Margin="0,0,0,16" />

                                    <!-- Overlay Alpha (0-100%) -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Overlay Alpha" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFFFF" />
                                        <TextBlock x:Name="AlphaValueText" Text="40%" FontWeight="Bold" FontSize="12" FontFamily="Consolas"
                                                   Foreground="#FFE4E4E7" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="AlphaSlider"
                                            Style="{StaticResource MonochromeSliderStyle}"
                                            Minimum="5" Maximum="100" SmallChange="5" LargeChange="10" Value="40"
                                            ValueChanged="AlphaSlider_ValueChanged"
                                            PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"
                                            Margin="0,4,0,2" />
                                    <TextBlock Text="Regulates how dark the screen overlay is (0-100%). Default: 40%."
                                               FontSize="11" Foreground="#FFA1A1AA" Margin="0,0,0,16" />

                                    <Border Height="1" Background="#FF27272A" Margin="0,0,0,16" />

                                    <!-- Global Hotkey -->
                                    <TextBlock Text="Global Hotkey" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFFFF" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FF000000" BorderBrush="#FF27272A" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                                            <TextBox x:Name="HotkeyTextBox" Text="Alt + Space" IsReadOnly="True"
                                                     Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0"
                                                     CaretBrush="#FFFFFFFF"
                                                     FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                     Padding="12,8" VerticalContentAlignment="Center" />
                                        </Border>
                                        <Button x:Name="ChangeKeybindButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Change Keybind" Click="ChangeKeybindButton_Click" Margin="0,0,8,0" />
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Reset (Alt+Space)" Click="ResetKeybindButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="KeybindRecordingHint" Text="Press shortcut (Ctrl, Alt, Shift + any key)..."
                                               FontSize="11" Foreground="#FFE4E4E7" Visibility="Collapsed" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- =============================================================== -->
                            <!-- 2. PLUGINS SECTION                                              -->
                            <!-- =============================================================== -->
                            <Border Background="#CC18181B" BorderBrush="#FF27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="PLUGINS" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFE4E4E7" Margin="0,0,0,16" />

                                    <!-- Row 1: Open Plugins Folder (Primary) & Restart FuncOverlay (Secondary) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Open Plugins Folder"
                                                Click="OpenPluginsFolder_Click"
                                                Margin="0,0,10,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Restart FuncOverlay"
                                                Click="RestartFuncOverlay_Click" />
                                    </StackPanel>

                                    <!-- Row 2: Clearly visible gray hint text -->
                                    <TextBlock Text="You need to restart FuncOverlay for the changes to take effect."
                                               FontSize="12" Foreground="#FFA1A1AA" Margin="0,0,0,16" />

                                    <!-- Row 3: Install Plugin button (Primary, opens custom picker for .zip or folder) -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Install Plugin"
                                            HorizontalAlignment="Left"
                                            Click="InstallPlugin_Click"
                                            Margin="0,0,0,4" />
                                    <TextBlock Text="Extracts plugins from directory folders or .zip archives into plugins directory."
                                               FontSize="11" Foreground="#FFA1A1AA" Margin="0,0,0,20" />

                                    <Border Height="1" Background="#FF27272A" Margin="0,0,0,16" />

                                    <!-- Installed Plugins Subheading -->
                                    <TextBlock Text="INSTALLED PLUGINS" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFE4E4E7" Margin="0,0,0,12" />

                                    <!-- Dynamic Items Control for Plugins -->
                                    <StackPanel x:Name="InstalledPluginsPanel">
                                        <TextBlock x:Name="NoPluginsText" Text="No plugins currently installed in plugins directory."
                                                   FontSize="12" Foreground="#FFA1A1AA" Margin="0,8,0,8" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Custom Inline Notification Toast (Replaces default Windows MessageBox) -->
                <Border x:Name="StatusToastBorder"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,20"
                        Background="#FF18181B"
                        BorderBrush="#FF3F3F46"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9">
                    <TextBlock x:Name="StatusToastText" Text="" FontSize="12" FontWeight="Medium" Foreground="#FFFFFFFF" />
                </Border>

                <!-- Custom Monochrome Confirmation Overlay (Replaces default Windows MessageBox) -->
                <Grid x:Name="ConfirmDialogOverlay"
                      Visibility="Collapsed"
                      Background="#CC000000">
                    <Border Width="380"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#FF09090B"
                            BorderBrush="#FF27272A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmDialogTitle"
                                       Text="Confirm Delete"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFFFF" />
                            <TextBlock x:Name="ConfirmDialogMessage"
                                       Text="Are you sure you want to delete this plugin?"
                                       FontSize="12"
                                       Foreground="#FFA1A1AA"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,18" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Cancel"
                                        Click="ConfirmCancel_Click"
                                        Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Delete Plugin"
                                        Click="ConfirmAccept_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
